# StillScript local config & logs (never commit — may contain an API key).
# The .danscribe* names are kept alongside the new ones: masterplan 4.1
# migrates them away on first launch, but a working copy touched by an
# older build can still produce them, and they must never be committed.
.stillscript_config.json
.stillscript.log
.danscribe_config.json
.danscribe.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller build artifacts
build/
dist/
*.spec

# Built executables. StillScript.exe is ~330 MB and was sitting untracked next
# to the source; one `git add -A` would have committed it permanently.
*.exe

# OS cruft
.DS_Store
Thumbs.db
